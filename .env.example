VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...
# Public bot username only (never the Telegram bot token):
# VITE_TELEGRAM_BOT_USERNAME=your_openmind_bot
# Optional for the single-file build:
# VITE_ROUTER=hash

# Server-only Supabase Edge Function secrets — never prefix these with VITE_.
# Configure them with `supabase secrets set`, not in the browser build:
# OPENMIND_CHAT_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_NOTIFICATION_TEMPLATE=
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
