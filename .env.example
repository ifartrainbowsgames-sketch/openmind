VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your_anon_or_publishable_key
# or: VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional for supabase functions deploy agent-tools:
# Search default is DuckDuckGo (no key). Prefer your own SearXNG instance (do not expect OpenMind to host it):
# SEARXNG_URL=https://search.example.com
# Optional paid upgrades:
# TAVILY_API_KEY=
# Hosted Chrome for web_act (optional). Same idea as Cursor's cloud browser:
# BROWSERLESS_API_KEY=
# BROWSERLESS_URL=https://production-sfo.browserless.io
# Code execution is E2B only — Edge Functions cannot run Docker/Daytona:
# E2B_API_KEY=
# Nango connector marketplace (optional). Secret stays on the Edge Function:
# NANGO_SECRET_KEY=
# NANGO_HOST=https://api.nango.dev
# Deploy nango-session (Connect UI) and nango-act (GitHub repo + file commits + branch + PR, Slack post):
# supabase functions deploy nango-session
# supabase functions deploy nango-act
# Optional Connect UI host for the iframe:
# VITE_NANGO_CONNECT_URL=https://connect.nango.dev

# Super Agent extras (not required for /app). See docs/super-agent.md
# LiteLLM / Langfuse / Open Deep Research / Browser Use are later workers — do not put those secrets in the Vite client.
# Signed-in memory uses public.agent_memories (RLS). Customers never set DB keys.
