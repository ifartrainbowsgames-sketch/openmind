{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationDir": "./node_modules/.tmp/scripts-types"
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts", "src/**/*.tsx", "src/**/*.json", "worker/**/*.ts", "supabase/functions/**/crypto.ts"]
}
