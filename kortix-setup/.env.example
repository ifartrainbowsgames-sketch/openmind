# Copy to .env and fill in values, then run: ./railway-deploy.sh
# Do NOT commit .env — it contains secrets.

# ── Supabase (required) ─────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Frontend uses the same Supabase project:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# ── LLM providers (at least OpenAI + Anthropic) ─────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=

# ── Search / scrape ─────────────────────────────────────────
TAVILY_API_KEY=tvly-...
FIRECRAWL_API_KEY=fc-...
FIRECRAWL_URL=https://api.firecrawl.dev

# ── Agent sandbox (Daytona) ─────────────────────────────────
DAYTONA_API_KEY=

# ── Background jobs (Upstash QStash) ────────────────────────
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Set after first backend deploy (Railway public URL):
WEBHOOK_BASE_URL=https://YOUR-BACKEND.up.railway.app

# Optional
SMITHERY_API_KEY=
ENV_MODE=production
