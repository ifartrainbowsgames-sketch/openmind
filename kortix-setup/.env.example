# Copy to .env and fill in values, then run: ./railway-deploy.sh
# Do NOT commit .env — it contains secrets.

# ── Supabase (required) ─────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Frontend uses the same Supabase project:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# ── LLM providers (at least OpenAI + Anthropic) ─────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=

# ── Search / scrape ─────────────────────────────────────────
TAVILY_API_KEY=tvly-...
FIRECRAWL_API_KEY=fc-...
FIRECRAWL_URL=https://api.firecrawl.dev

# ── Agent sandbox (pick ONE provider) ───────────────────────
# Railway template (./railway-deploy.sh) requires Daytona only.
# Official self-host (./configure-sandbox.sh) supports E2B or Platinum instead.
SANDBOX_PROVIDER=e2b

# Option 1 — E2B (recommended if Daytona signup fails; free $100 credits)
# https://e2b.dev/dashboard?tab=keys
E2B_API_KEY=

# Option 2 — Platinum (Kortix microVM; run: npm i -g @platinum-dev/cli && pt login)
PLATINUM_API_KEY=

# Option 3 — Daytona (required for Railway template only)
DAYTONA_API_KEY=
DAYTONA_SERVER_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# ── Background jobs (Upstash QStash) ────────────────────────
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Set after first backend deploy (Railway public URL):
WEBHOOK_BASE_URL=https://YOUR-BACKEND.up.railway.app

# Optional
SMITHERY_API_KEY=
ENV_MODE=production
